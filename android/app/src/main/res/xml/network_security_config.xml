<?xml version="1.0" encoding="utf-8"?>
<!-- Jellyfin suele estar en la red local por http://, y algunos servidores usan certificados
     propios: se permite tráfico sin cifrar y se confía en las CA que el usuario instale. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
