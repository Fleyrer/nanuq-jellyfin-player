{
  "name": "nanuq",
  "productName": "Nanuq",
  "version": "1.47.4",
  "description": "Cliente de música para Jellyfin",
  "main": "main.js",
  "author": {
    "name": "Nanuq",
    "email": "nanuq@localhost"
  },
  "homepage": "https://github.com/Fleyrer/nanuq-jellyfin-player",
  "license": "GPL-3.0-or-later",
  "private": true,
  "scripts": {
    "prepare-web": "node prepare-web.js",
    "start": "node prepare-web.js && electron .",
    "dist": "node prepare-web.js && USE_SYSTEM_FPM=true electron-builder --linux AppImage rpm && node collect.js",
    "dist:appimage": "node prepare-web.js && electron-builder --linux AppImage && node collect.js",
    "dist:win": "node prepare-web.js && electron-builder --win nsis && node collect.js"
  },
  "build": {
    "appId": "com.nanuq.app",
    "productName": "Nanuq",
    "executableName": "nanuq",
    "artifactName": "nanuq-${version}-${arch}.${ext}",
    "directories": {
      "output": "../dist/_build"
    },
    "files": [
      "main.js",
      "preload.js",
      "www/**/*"
    ],
    "linux": {
      "icon": "www/icons/icon-512.png",
      "category": "AudioVideo",
      "synopsis": "Música desde tu servidor Jellyfin",
      "description": "Cliente de música para tu servidor Jellyfin, con letras sincronizadas, mezclas y temas.",
      "desktop": {
        "entry": {
          "Name": "Nanuq",
          "GenericName": "Reproductor de música",
          "Comment": "Música desde tu servidor Jellyfin",
          "Categories": "AudioVideo;Audio;Player;",
          "Keywords": "música;music;jellyfin;reproductor;",
          "StartupWMClass": "Nanuq"
        }
      }
    },
    "rpm": {
      "fpm": [
        "--rpm-rpmbuild-define",
        "_build_id_links none"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "www/icons/icon-512.png",
      "artifactName": "nanuq-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nanuq",
      "installerLanguages": [
        "es_ES"
      ],
      "language": "3082",
      "deleteAppDataOnUninstall": false,
      "uninstallDisplayName": "Nanuq"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    }
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  }
}
